        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formData",
              "name": "emailExpediteur",
              "value": "={{ $json.from ? $json.from.value[0].address : $json.from }}"
            },
            {
              "parameterType": "formData",
              "name": "nomExpediteur",
              "value": "={{ $json.from ? ($json.from.value[0].name || '') : '' }}"
            },
            {
              "parameterType": "formData",
              "name": "sujet",
              "value": "={{ $json.subject }}"
            },
            {
              "parameterType": "formData",
              "name": "corps",
              "value": "={{ $json.text }}"
            },
            {
              "parameterType": "formData",
              "name": "referenceSourceImport",
              "value": "={{ 'imap:' + ($json.messageId || $json.date) }}"
            },
            {
              "parameterType": "formBinaryData",
              "name": "cv",
              "inputDataFieldName": "attachment_0"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
