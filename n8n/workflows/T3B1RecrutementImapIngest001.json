              "value": "={{ $json.subject }}"
            },
            {
              "parameterType": "formData",
              "name": "corps",
              "value": "={{ $json.text }}"
            },
            {
              "parameterType": "formData",
              "name": "referenceSourceImport",
              "value": "={{ 'imap:' + ($json.messageId || $json.date) }}"
            },
            {
              "parameterType": "formBinaryData",
              "name": "cv",
              "inputDataFieldName": "attachment_0"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
