# Contrat documenté des variables d'environnement — copier en .env (gitignored)
# et renseigner les valeurs locales. Ne jamais committer .env ni un vrai secret ici.

# --- PostgreSQL (service "db" du docker-compose + datasource backend) ---
POSTGRES_DB=rh_dev
POSTGRES_USER=rh_dev
POSTGRES_PASSWORD=change_me_dev_only

# L'hôte est le nom du service compose ("db"), pas "localhost" : c'est le backend
# conteneurisé qui ouvre la connexion, depuis le réseau Docker.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/rh_dev
SPRING_DATASOURCE_USERNAME=rh_dev
SPRING_DATASOURCE_PASSWORD=change_me_dev_only

# --- Serveur backend ---
SERVER_PORT=8080
# Profil Spring actif. "dev" charge application-dev.yml (logs DEBUG, SQL formaté).
# Aucun profil "prod" n'existe aujourd'hui : hors dev, laisser vide ou non défini
# suffit — application.yml seul s'applique alors (cf. docs/04-deploiement.md §2.4).
SPRING_PROFILES_ACTIVE=dev

# --- Sécurité JWT (NFR-SEC-01) ---
# Clé de signature des jetons. Minimum 64 caractères, propre à chaque environnement
# et JAMAIS réutilisée entre dev/CI/prod : quiconque la connaît peut forger un jeton
# admin. La valeur ci-dessous est publique (elle est dans Git) — dev uniquement.
JWT_SECRET=changeme_dev_jwt_secret_must_be_at_least_64_chars_long_x
# Durée de vie d'un jeton, en millisecondes (86400000 = 24 h).
JWT_EXPIRATION_MS=86400000

# --- URLs publiques ---
# Adresse à laquelle les utilisateurs joignent le frontend. Sert à construire les liens
# envoyés par e-mail (réinitialisation de mot de passe, EF-AUTH-06) : une valeur fausse
# produit des e-mails contenant un lien inutilisable.
APP_BASE_URL=http://localhost:5173
# Adresse publique de l'API, telle qu'un destinataire d'e-mail doit pouvoir la joindre.
# Sert aux liens de téléchargement des documents RH envoyés par e-mail.
# En dev elle diffère d'APP_BASE_URL : le serveur Vite (5173) ne relaie pas /api,
# l'API se joint directement sur 8080. En production, où nginx relaie /api/ vers le
# backend, les deux valeurs sont normalement identiques.
API_BASE_URL=http://localhost:8080
# Origines autorisées à appeler l'API depuis un navigateur (CORS), séparées par des virgules.
# Doit inclure l'origine réelle du frontend, sinon toutes les requêtes sont bloquées côté client.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Stockage fichiers (shared/file, table `fichiers`) ---
# Dossier où le backend écrit les fichiers uploadés (CV, pièces jointes employé...).
# En dev : bind mount ./data/uploads (voir docker-compose.yml), visible localement.
# En prod, si un backend objet (S3/MinIO) remplace le disque local, cette variable
# et FileStorageService seront les deux seuls points à changer (shared/file quarantine
# le détail de stockage derrière une interface, cf. ai-instructions.md règle 6).
FILE_STORAGE_PATH=/data/uploads
# Taille max par fichier, en Mo (NFR-SEC-07 — valeur configurable, 10 par défaut).
FILE_MAX_SIZE_MB=10

# --- Partagée avec Mentora-managment-fe ---
# URL de base que le client API du frontend utilise pour joindre le backend.
VITE_API_BASE_URL=http://localhost:8080

# --- n8n (transport only : webhooks, cron, SMTP/IMAP — voir n8n/README.md) ---
# Clé de chiffrement des credentials n8n (SMTP, IMAP, etc. stockés dans sa propre base).
# Change_me en dev ; à régénérer et garder secrète en production.
N8N_ENCRYPTION_KEY=change_me_dev_only_n8n_encryption_key
N8N_HOST=localhost
#
# ATTENTION : les deux variables ci-dessous se ressemblent mais ne servent pas au même.
#
# 1) Lue par LE BACKEND — origine de n8n telle qu'il la joint (schéma + hôte + port,
#    sans chemin). Le chemin /webhook/notify-email est ajouté par le code.
#    En docker-compose, le backend joint n8n par son nom de service : http://n8n:5678
N8N_BASE_URL=http://n8n:5678
# 2) Lue par N8N LUI-MÊME — son URL publique, dont il se sert pour afficher/construire
#    les URLs de ses propres webhooks. Rien à voir avec la façon dont le backend l'appelle.
N8N_WEBHOOK_URL=http://localhost:5678/

# --- Recrutement : ingestion e-mail IMAP (EF-REC-02, shared/ai, T3.B1) ---
# Boîte mail surveillée par le workflow n8n IMAP (n8n/workflows/T3B1RecrutementImapIngest001.json)
# — en dev, une boîte de test personnelle (voir n8n/README.md § Boîte mail de recrutement) ;
# en prod, la vraie adresse recrutement HB Développement. Ne jamais commiter les vraies valeurs
# dans .env — seulement dans le .env local gitignored de chaque dev.
RECRUITMENT_IMAP_HOST=imap.example.com
RECRUITMENT_IMAP_PORT=993
RECRUITMENT_IMAP_USER=recrutement-test@example.com
RECRUITMENT_IMAP_PASSWORD=change_me_dev_only

# Analyse IA des CV (shared/ai/CvAnalysisProvider, EF-REC-04). Vide = dégradation gracieuse
# (EF-REC-05) : les candidatures restent en "analyse en attente", l'app démarre normalement.
# OpenRouter (openrouter.ai) — clé gratuite sans carte bancaire, modèle par défaut gratuit
# (50 requêtes/jour). Remplace Gemini depuis le 2026-07-28 (palier gratuit Gemini bloqué à un
# quota de 0, facturation impossible à activer côté HB Développement — cf. avancement-projet.md).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Secret partagé pour les endpoints appelés uniquement par n8n (jamais par un utilisateur
# connecté) — ingestion recrutement (EF-REC-02) et cron d'archivage (EF-REC-12), vérifiés par
# InternalWebhookGuard. Doit correspondre au credential Header Auth "Recrutement Webhook Secret
# (dev)" côté n8n (voir n8n/README.md). À regénérer en production.
INTERNAL_WEBHOOK_SECRET=change_me_dev_only_internal_webhook_secret

# --- Notifications in-app + Mattermost prive (T3.A1) ---
# Laisser vide en local sans Mattermost : l'in-app reste creee et l'echec est journalise.
# Pour envoyer en prive, creer un bot Mattermost puis renseigner son token et son user id.
MATTERMOST_BASE_URL=
MATTERMOST_BOT_TOKEN=
MATTERMOST_BOT_USER_ID=
# true : si mattermost_user_id n'est pas renseigne sur le compte, le backend tente une recherche
# Mattermost par email via /api/v4/users/email/{email}.
MATTERMOST_LOOKUP_USER_BY_EMAIL=true
MATTERMOST_CONNECT_TIMEOUT_MS=3000
MATTERMOST_READ_TIMEOUT_MS=5000
# Archivage quotidien a 02:15 des notifications depassant la retention configuree (90 j par defaut).
NOTIFICATIONS_ARCHIVAGE_CRON=0 15 2 * * *
# EF-AUTH-13/15 : purge quotidienne a 02:30 des delegations echues (dateFin depassee sans revocation
# manuelle) — bascule leur statut vers "expiree" et declenche le ping Mattermost de fin (EF-AUTH-15).
DELEGATIONS_EXPIRATION_CRON=0 30 2 * * *
# EF-NOTIF-05 : retention des notifications in-app avant archivage automatique (90 jours par defaut).
NOTIFICATIONS_RETENTION_JOURS=90

# --- Securite (NFR-SEC-08/EF-AUTH-09/EF-AUTH-10) — constantes techniques fixees au deploiement,
# jamais admin-editables en libre-service (decision T4.B2 du 2026-07-24, avancement-projet.md). ---
SECURITY_LOCKOUT_MAX_ATTEMPTS=5
SECURITY_LOCKOUT_DELAY_MINUTES=30
SECURITY_PASSWORD_MIN_LENGTH=10
SECURITY_PASSWORD_REQUIRE_UPPERCASE=true
SECURITY_PASSWORD_REQUIRE_LOWERCASE=true
SECURITY_PASSWORD_REQUIRE_DIGIT=true
SECURITY_SESSION_INACTIVITE_MINUTES=30

# --- Recrutement : reactivation des candidatures "En attente" (EF-REC-12) ---
RECRUITMENT_REACTIVATION_SEUIL_SCORE=70
RECRUITMENT_REACTIVATION_FENETRE_MOIS=6
# Archivage quotidien des candidatures "En attente" hors fenetre de retention (EF-REC-12).
# Decale a 03:30 (heure de Casablanca) pour ne pas coincider avec DOCUMENTS_SURVEILLANCE_CRON (03:00).
RECRUITMENT_ARCHIVAGE_CRON=0 30 3 * * *

# --- Documents RH : surveillance des fins de contrat (EF-DOC-02/12/13/14) ---
DOCUMENTS_DELAI_FIN_STAGE_JOURS=3
DOCUMENTS_DELAI_FIN_CDD_JOURS=15
DOCUMENTS_DELAI_RELANCE_FIN_CDD_JOURS=3
# Balayage quotidien des notifications de fin de contrat arrivees a echeance (03h00,
# heure de Casablanca). Job @Scheduled du backend, pas un workflow n8n.
DOCUMENTS_SURVEILLANCE_CRON=0 0 3 * * *
# Pas de variable pour le destinataire : les alertes de fin de contrat partent vers
# le(s) compte(s) Admin actif(s), lu(s) en base. Changer l'adresse de l'Admin depuis
# l'application suffit, il n'y a rien a mettre a jour ici.
